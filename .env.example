# Optional defaults for tools/test-e2e.sh.
# Copy to .env, fill locally and keep permissions at 0600.

VPS_HOST=
VPS_PORT=22
VPS_PASS=

ROUTER_IP=192.168.1.1
ROUTER_PORT=22
ROUTER_USER=root

# Temporary localhost forwards used by the Remote Admin lifecycle probe.
REMOTE_LOCAL_SSH_PORT=2299
REMOTE_LOCAL_LUCI_PORT=8099
REMOTE_WAIT_SECONDS=60
REMOTE_REQUEST_TTL=300
